# Get these from https://dashboard.linqapp.com/sandbox-signup/
LINQ_API_KEY=
# Your Linq sandbox number (E.164), e.g. +15551234567
LINQ_FROM_NUMBER=
# Peer who texts you (email or E.164) — used for chat mirror + location
LINQ_TO_EMAIL=
# Optional: only used by npm run send AFTER the recipient has texted you first
LINQ_TO_NUMBER=

# Public HTTPS base URL for webhooks (ngrok / localtunnel), no trailing slash
# e.g. https://abc123.loca.lt
WEBHOOK_PUBLIC_URL=

PORT=8787

# Part 3 (Prava) — APPROVE in iMessage triggers discover → quote → sandbox pay
PART3_API=http://127.0.0.1:8788

# MilkWatch OpenAI agent (dedicated key recommended — separate from Part1 vision)
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-4o
# STATUS → dummy vision (full|half|empty) or live camera
# STATUS_VISION_CASE=half
# STATUS_USE_CAMERA=false
# PART1_API=http://127.0.0.1:8765
# AUTO_ALERT=true
# RUNWAY_ALERT_DAYS=2.5

# Location: Linq live share needs account entitlement + user accepting the iMessage prompt.
# Until a live share exists, GET /api/location falls back to a demo NYU pin.
