# Copy to .env and fill in:
#   cp .env.example .env

# Provider: openai | anthropic
VISION_PROVIDER=anthropic

# Use ONE of these keys (matching VISION_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# IP Webcam base URL (from the phone app — no trailing path)
IP_WEBCAM_URL=http://192.168.12.248:8080

# How often to grab + classify a frame (seconds)
SAMPLE_INTERVAL_SEC=10

# Emit stockout only after this many consecutive low/empty reads
DEBOUNCE_COUNT=2

# Models
OPENAI_VISION_MODEL=gpt-4o
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
